import { IsNumber, IsOptional, IsString } from 'class-validator';

/** Core runtime env vars: server + DOCS auth. */
export class CoreEnv {
  @IsNumber()
  PORT!: number;

  @IsString()
  @IsOptional()
  NODE_ENV?: string;

  @IsString()
  GLOBAL_PREFIX!: string;

  @IsString()
  @IsOptional()
  DOCS_USERNAME?: string;

  @IsString()
  @IsOptional()
  DOCS_PASSWORD?: string;
}
