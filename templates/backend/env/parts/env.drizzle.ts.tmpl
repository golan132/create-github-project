import { IsNumber, IsOptional, IsString } from 'class-validator';
__BASE_IMPORT__

/** Postgres / Drizzle ORM connection settings. */
export class DrizzleEnv extends __BASE_CLASS__ {
  @IsString()
  DATABASE_URL!: string;

  @IsString()
  @IsOptional()
  DATABASE_HOST?: string;

  @IsNumber()
  @IsOptional()
  DATABASE_PORT?: number;

  @IsString()
  @IsOptional()
  DATABASE_NAME?: string;

  @IsString()
  @IsOptional()
  DATABASE_USER?: string;

  @IsString()
  @IsOptional()
  DATABASE_PASSWORD?: string;
}
