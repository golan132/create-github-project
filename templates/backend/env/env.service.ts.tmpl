import { Injectable, Logger } from '@nestjs/common';
import { ConfigService, Path, PathValue } from '@nestjs/config';
import { EnvVars } from './env.validation';

@Injectable()
export class EnvService {
  private readonly logger = new Logger(EnvService.name);
  /** Runtime overrides — takes precedence over ConfigService values */
  private overrides = new Map<string, unknown>();

  constructor(private readonly configService: ConfigService<EnvVars>) {}

  get<P extends Path<EnvVars>, R = PathValue<EnvVars, P>>(propertyPath: P): R {
    if (this.overrides.has(propertyPath)) {
      return this.overrides.get(propertyPath) as R;
    }
    return this.configService.get(propertyPath, { infer: true })!;
  }

  /** Set a runtime override (does NOT persist to .env on disk). */
  set<P extends Path<EnvVars>>(propertyPath: P, value: unknown): void {
    this.overrides.set(propertyPath, value);
    this.logger.log(`Runtime override: ${propertyPath} = ${value}`);
  }

  /** Remove a runtime override, reverting to the .env value. */
  reset<P extends Path<EnvVars>>(propertyPath: P): void {
    this.overrides.delete(propertyPath);
  }

  hasOverride<P extends Path<EnvVars>>(propertyPath: P): boolean {
    return this.overrides.has(propertyPath);
  }
}
