import { plainToInstance } from 'class-transformer';
import { validateSync } from 'class-validator';
import { isEmpty } from 'lodash/fp';
__IMPORTS__

/**
 * Full validated environment shape, composed via class inheritance so each
 * domain lives in its own file under `parts/`. class-validator picks up
 * decorators from the entire prototype chain.
 */
export class EnvVars extends __EXTENDS__ {}

export const validate = (config: Record<string, unknown>): EnvVars => {
  const validatedConfig = plainToInstance(EnvVars, config, {
    enableImplicitConversion: true,
  });
  const errors = validateSync(validatedConfig, { skipMissingProperties: false });

  if (!isEmpty(errors)) {
    console.error('Environment validation errors:', errors);
    throw new Error(errors.toString());
  }

  return validatedConfig;
};
