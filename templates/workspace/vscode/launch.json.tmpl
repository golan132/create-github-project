{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug __SERVICE_NAME__ with Nx",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["nx", "serve", "__SERVICE_NAME__"],
      "env": {
        "NODE_OPTIONS": "--inspect=9229"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/dist/apps/backend/__SERVICE_NAME__/**/*.(m|c|)js",
        "!**/node_modules/**"
      ]
    }
  ]
}
